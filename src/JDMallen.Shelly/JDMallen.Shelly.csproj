<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>shelly</AssemblyName>
		<RootNamespace>JDMallen.Shelly</RootNamespace>
		<RollForward>LatestMajor</RollForward>
		<IsAotCompatible>true</IsAotCompatible>
		<!-- LibraryImport (process-tree P/Invokes in ProcessTree.cs) requires it. -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<!-- Resources/Strings.resx is en-US; skips a satellite lookup for it. -->
		<NeutralLanguage>en-US</NeutralLanguage>
	</PropertyGroup>

	<!-- Publish settings: only apply during `dotnet publish` for a specific RID,
			 so the test project can still reference the main project in Release builds. -->
	<PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
		<PublishAot>true</PublishAot>
		<SelfContained>true</SelfContained>
		<OptimizationPreference>Size</OptimizationPreference>
		<DebugType>none</DebugType>
		<DebuggerSupport>false</DebuggerSupport>
		<EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
		<EventSourceSupport>false</EventSourceSupport>
		<HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
		<MetadataUpdaterSupport>false</MetadataUpdaterSupport>
		<!-- UseSystemResourceKeys deliberately left off: it saves ~8 KB but turns
				 every framework message the user sees (JSON parse errors, HTTP
				 failures) into a bare resource key. -->
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="JDMallen.Shelly.Tests"/>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="JetBrains.Annotations" Version="2025.2.4"/>
		<PackageReference Include="JDMallen.Toolbox.AI" Version="4.7.0"/>
		<PackageReference Include="JDMallen.Toolbox.AI.Azure" Version="4.7.0"/>
	</ItemGroup>

	<ItemGroup>
		<!-- Chat client types (IChatCompletionClient et al.) used throughout. -->
		<Using Include="JDMallen.Toolbox.AI"/>
	</ItemGroup>

</Project>
